

-- Create tables and load data

--create order table
DROP TABLE IF EXISTS bronze.orders_data;
CREATE TABLE bronze.orders_data (
    order_id                       NVARCHAR(50),
    customer_id                    NVARCHAR(50),
    order_status                   NVARCHAR(50),
    order_purchase_timestamp       NVARCHAR(50),
    order_approved_at              NVARCHAR(50),
    order_delivered_carrier_date   NVARCHAR(50),
    order_delivered_customer_date  NVARCHAR(50),
    order_estimated_delivery_date  NVARCHAR(50)
);

--load data into bronze.orders_data table
TRUNCATE TABLE bronze.orders_data;
BULK INSERT bronze.orders_data
FROM 'C:\Users\LENOVO\OneDrive\Desktop\olist_data1\olist_orders_dataset.csv'
WITH (
    FIRSTROW = 2,
    FIELDTERMINATOR = ',',
    ROWTERMINATOR = '0x0a',
    CODEPAGE = '65001',
    TABLOCK
);

SELECT * FROM bronze.orders_data;


